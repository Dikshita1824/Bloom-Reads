
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Book - Bloom Reads</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        h1, h2 {
            font-family: 'Cormorant Garamond', serif;
        }
    </style>
</head>

<body class="bg-[#FFF9F5] text-[#492632]">

    <!-- Navbar -->
    <%- include('includes/nav.ejs') %>

    <!-- Edit Book Section -->
    <section class="px-5 py-12 md:py-16">

        <div class="max-w-3xl mx-auto">

            <!-- Heading -->
            <div class="text-center mb-9">

                <p class="text-[#A04460] uppercase tracking-[0.25em] text-xs md:text-sm mb-3">
                    Bloom Reads Collection
                </p>

                <h1 class="text-4xl md:text-5xl font-bold text-[#641E36]">
                    Edit Book
                </h1>

                <p class="text-[#A77C87] text-sm mt-3">
                    Update your book details below.
                </p>

                <div class="w-16 h-1 bg-[#A04460] rounded-full mx-auto mt-5"></div>

            </div>

            <!-- Form Box -->
            <form
                action="/books/edit/<%= book._id %>"
                method="POST"
                enctype="multipart/form-data"
                class="bg-[#FBE8DF] border border-[#F5D4D8] shadow-md rounded-2xl p-6 md:p-9"
            >

                <!-- TITLE -->
                <div class="mb-5">

                    <label for="title" class="block text-sm font-medium text-[#641E36] mb-2">
                        Book Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= book.title %>"
                        required
                        class="w-full px-4 py-3 rounded-lg bg-[#FFF9F5] border border-[#E8C5CD] focus:outline-none focus:ring-2 focus:ring-[#A04460] transition"
                    >

                </div>

                <!-- AUTHOR -->
                <div class="mb-5">

                    <label for="author" class="block text-sm font-medium text-[#641E36] mb-2">
                        Author Name
                    </label>

                    <input
                        type="text"
                        id="author"
                        name="author"
                        value="<%= book.author %>"
                        required
                        class="w-full px-4 py-3 rounded-lg bg-[#FFF9F5] border border-[#E8C5CD] focus:outline-none focus:ring-2 focus:ring-[#A04460] transition"
                    >

                </div>

                <!-- PRICE -->
                <div class="mb-5">

                    <label for="price" class="block text-sm font-medium text-[#641E36] mb-2">
                        Price (₹)
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        min="0"
                        step="0.01"
                        value="<%= book.price %>"
                        required
                        class="w-full px-4 py-3 rounded-lg bg-[#FFF9F5] border border-[#E8C5CD] focus:outline-none focus:ring-2 focus:ring-[#A04460] transition"
                    >

                </div>

                <!-- CATEGORY -->
                <div class="mb-6">

                    <label for="category" class="block text-sm font-medium text-[#641E36] mb-2">
                        Book Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        required
                        class="w-full px-4 py-3 rounded-lg bg-[#FFF9F5] border border-[#E8C5CD] focus:outline-none focus:ring-2 focus:ring-[#A04460] transition"
                    >

                        <option value="Fiction" <%= book.category === 'Fiction' ? 'selected' : '' %>>
                            Fiction
                        </option>

                        <option value="Romance" <%= book.category === 'Romance' ? 'selected' : '' %>>
                            Romance
                        </option>

                        <option value="Mystery" <%= book.category === 'Mystery' ? 'selected' : '' %>>
                            Mystery
                        </option>

                        <option value="Fantasy" <%= book.category === 'Fantasy' ? 'selected' : '' %>>
                            Fantasy
                        </option>

                        <option value="Classic" <%= book.category === 'Classic' ? 'selected' : '' %>>
                            Classic
                        </option>

                        <option value="Self-Help" <%= book.category === 'Self-Help' ? 'selected' : '' %>>
                            Self-Help
                        </option>

                    </select>

                </div>

                <!-- CURRENT IMAGE -->
                <div class="mb-6">

                    <label class="block text-sm font-medium text-[#641E36] mb-3">
                        Current Book Cover
                    </label>

                    <% if (book.image) { %>

                        <div class="inline-block bg-[#FFF9F5] p-3 rounded-xl border border-[#F5D4D8] shadow-sm">

                            <img
                                src="<%= book.image %>"
                                alt="<%= book.title %>"
                                class="w-36 h-48 object-cover rounded-lg"
                            >

                        </div>

                    <% } else { %>

                        <div class="w-36 h-48 rounded-xl bg-[#FFF9F5] border border-[#F5D4D8] flex items-center justify-center text-center p-3">
                            <p class="text-sm text-[#A77C87]">
                                No cover image available
                            </p>
                        </div>

                    <% } %>

                </div>

                <!-- NEW IMAGE -->
                <div class="mb-8">

                    <label for="img" class="block text-sm font-medium text-[#641E36] mb-2">
                        Upload New Cover
                    </label>

                    <input
                        type="file"
                        id="img"
                        name="img"
                        accept="image/*"
                        class="w-full px-3 py-3 rounded-lg bg-[#FFF9F5] border border-[#E8C5CD] text-sm file:mr-4 file:rounded-md file:border-0 file:bg-[#F5D4D8] file:px-3 file:py-2 file:text-[#641E36] file:font-medium"
                    >

                    <p class="text-xs text-[#A77C87] mt-2">
                        Leave this field empty to keep the current cover image.
                    </p>

                </div>

                <!-- BUTTONS -->
                <div class="flex flex-col sm:flex-row gap-3">

                    <button
                        type="submit"
                        class="flex-1 bg-[#641E36] text-white px-6 py-3 rounded-lg font-medium hover:bg-[#A04460] transition duration-300"
                    >
                        Update Book
                    </button>

                    <a
                        href="/books"
                        class="flex-1 text-center border border-[#A04460] text-[#641E36] px-6 py-3 rounded-lg font-medium hover:bg-[#F5D4D8] transition duration-300"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </section>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

</body>
</html>

