<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bloom Reads | Home</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            background-color: #fff8f3;
            color: #450920;
            font-family: 'DM Sans', sans-serif;
        }

        .heading {
            font-family: 'Playfair Display', serif;
        }

        .book-card {
            transition: 0.2s;
        }

        .book-card:hover {
            transform: translateY(-4px);
        }

        .pink-button {
            background-color: #a53860;
            color: white;
        }

        .pink-button:hover {
            background-color: #450920;
        }
    </style>
</head>

<body>

    <%- include('includes/nav.ejs') %>

    <!-- HERO SECTION -->

    <section class="px-6 py-12 md:py-20">

        <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2">

            <div>

                <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    Welcome to Bloom Reads
                </p>

                <h1 class="heading text-4xl leading-tight sm:text-5xl lg:text-6xl">
                    Turn the page.
                    <br>
                    <span class="text-[#a53860]">Find your bloom.</span>
                </h1>

                <p class="mt-6 max-w-lg leading-7 text-[#450920]/75">
                    Discover books that inspire you, take you on adventures
                    and help you learn something new. Your next favourite
                    book might be waiting here!
                </p>

                <div class="mt-7 flex flex-wrap gap-3">

                    <a href="/books"
                       class="pink-button rounded-lg px-6 py-3 text-sm font-semibold">
                        Browse Books →
                    </a>

                    <a href="/categories"
                       class="rounded-lg border border-[#a53860] px-6 py-3 text-sm font-semibold text-[#a53860] hover:bg-[#ffa5ab]/20">
                        Explore Categories
                    </a>

                </div>

            </div>

            <!-- HERO IMAGE -->

            <div class="mx-auto w-full max-w-md">

                <img
                    src="/uploads/h4.jpg"
                    alt="Books and reading"
                    class="h-[300px] w-full rounded-2xl object-cover shadow-md sm:h-[380px]"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >

                <div class="hidden h-[300px] flex-col items-center justify-center rounded-2xl bg-[#f9dbbd] sm:h-[380px]">
                    <span class="text-7xl">📚</span>
                    <p class="heading mt-4 text-2xl">A World of Stories</p>
                </div>

            </div>

        </div>

    </section>


    <!-- SMALL INTRO SECTION -->

    <section class="bg-[#f9dbbd]/60 px-6 py-10 text-center">

        <h2 class="heading text-2xl sm:text-3xl">
            Every book has a story to tell.
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-[#450920]/75 sm:text-base">
            Find something you love, explore new ideas and make time
            for reading with Bloom Reads.
        </p>

    </section>


    <!-- ABOUT SECTION -->

    <section class="px-6 py-16">

        <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2">

            <div class="mx-auto w-full max-w-sm">

                <img
                    src="/uploads/book-stack.jpg"
                    alt="A stack of books"
                    class="h-72 w-full rounded-2xl object-cover"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >

                <div class="hidden h-72 flex-col items-center justify-center rounded-2xl bg-[#ffa5ab]/50">
                    <span class="text-6xl">📖</span>
                    <p class="heading mt-3 text-xl">Happy Reading!</p>
                </div>

            </div>

            <div>

                <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    About Us
                </p>

                <h2 class="heading text-3xl sm:text-4xl">
                    A little corner for every reader.
                </h2>

                <p class="mt-5 leading-7 text-[#450920]/75">
                    Bloom Reads is an online bookstore made for people
                    who enjoy reading and discovering new books.
                </p>

                <p class="mt-4 leading-7 text-[#450920]/75">
                    From exciting fiction to educational books, we bring
                    different genres together so you can easily find
                    something interesting to read.
                </p>

                <a href="/about"
                   class="pink-button mt-6 inline-block rounded-lg px-6 py-3 text-sm font-semibold">
                    Learn More →
                </a>

            </div>

        </div>

    </section>


    <!-- POPULAR CATEGORIES -->

    <section class="bg-[#f9dbbd]/40 px-6 py-16">

        <div class="mx-auto max-w-6xl">

            <div class="mb-10 text-center">

                <p class="text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    Explore Books
                </p>

                <h2 class="heading mt-3 text-3xl sm:text-4xl">
                    Find Your Favourite Genre
                </h2>

                <p class="mt-3 text-sm text-[#450920]/70 sm:text-base">
                    Choose a category and start exploring.
                </p>

            </div>


            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

                <!-- Fiction -->

                <a href="/categories/Fiction"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#ffa5ab]/40 text-3xl">
                        📚
                    </div>

                    <h3 class="heading text-2xl">Fiction</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Enjoy imaginative stories and exciting adventures.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>


                <!-- Academics -->

                <a href="/categories/Academics"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#f9dbbd] text-3xl">
                        📖
                    </div>

                    <h3 class="heading text-2xl">Academics</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Find educational books and helpful study material.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>


                <!-- Mystery -->

                <a href="/categories/Mystery"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#a53860]/15 text-3xl">
                        🔎
                    </div>

                    <h3 class="heading text-2xl">Mystery</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Discover secrets, solve mysteries and enjoy surprises.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>


                <!-- Fantasy -->

                <a href="/categories/Fantasy"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#ffa5ab]/40 text-3xl">
                        ✨
                    </div>

                    <h3 class="heading text-2xl">Fantasy</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Step into magical worlds and extraordinary adventures.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>


                <!-- Science -->

                <a href="/categories/Science"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#f9dbbd] text-3xl">
                        🔬
                    </div>

                    <h3 class="heading text-2xl">Science</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Learn about science, discoveries and the world around us.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>


                <!-- Biography -->

                <a href="/categories/Biography"
                   class="book-card rounded-xl bg-white p-6 shadow-sm">

                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-xl bg-[#a53860]/15 text-3xl">
                        💗
                    </div>

                    <h3 class="heading text-2xl">Biography</h3>

                    <p class="mt-2 text-sm leading-6 text-[#450920]/70">
                        Read about inspiring people and their life journeys.
                    </p>

                    <p class="mt-4 text-sm font-semibold text-[#a53860]">
                        Explore Books →
                    </p>

                </a>

            </div>


            <div class="mt-10 text-center">

                <a href="/categories"
                   class="pink-button inline-block rounded-lg px-7 py-3 font-semibold">
                    View All Categories →
                </a>

            </div>

        </div>

    </section>


    <!-- READING MESSAGE -->

    <section class="px-6 py-16">

        <div class="mx-auto max-w-4xl rounded-2xl bg-[#450920] px-6 py-12 text-center text-white sm:px-12">

            <p class="text-sm font-semibold uppercase tracking-widest text-[#ffa5ab]">
                A Little Reminder
            </p>

            <h2 class="heading mt-4 text-3xl sm:text-4xl">
                Every reader starts with one page.
            </h2>

            <p class="mx-auto mt-4 max-w-xl leading-7 text-white/80">
                Take a break, pick a book and enjoy a few moments
                in a world full of imagination.
            </p>

            <a href="/books"
               class="mt-7 inline-block rounded-lg bg-[#ffa5ab] px-6 py-3 font-semibold text-[#450920] hover:bg-[#f9dbbd]">
                Find Your Next Book →
            </a>

        </div>

    </section>


    <!-- CONTACT SECTION -->

    <section class="px-6 pb-16">

        <div class="mx-auto max-w-4xl rounded-2xl border border-[#a53860]/20 bg-white px-6 py-10 text-center">

            <h2 class="heading text-3xl sm:text-4xl">
                Have a question?
            </h2>

            <p class="mx-auto mt-4 max-w-xl leading-7 text-[#450920]/70">
                Have a suggestion or need help? We would love to hear from you.
            </p>

            <a href="/contact"
               class="pink-button mt-6 inline-block rounded-lg px-6 py-3 font-semibold">
                Contact Us →
            </a>

        </div>

    </section>


    <%- include('includes/footer.ejs') %>

</body>
</html>