<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bloom Reads | Home</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background-color: #fff8f3;
            color: #450920;
            font-family: 'DM Sans', sans-serif;
        }

        .heading {
            font-family: 'Playfair Display', serif;
        }

        .book-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-width: 0;
            padding: 28px;
            border-radius: 16px;
            background-color: #ffffff;
            box-shadow: 0 2px 5px rgba(69, 9, 32, 0.10);
            text-decoration: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .book-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 18px rgba(69, 9, 32, 0.12);
        }

        .category-label {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            min-height: 80px;
            flex-shrink: 0;
            margin-bottom: 22px;
            padding: 8px;
            border-radius: 15px;
            text-align: center;
        }

        .category-label span {
            font-family: 'Playfair Display', serif;
            font-size: 13px;
            font-weight: 700;
            color: #450920;
            overflow-wrap: anywhere;
        }

        .book-card h3 {
            margin: 0;
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            line-height: 1.35;
        }

        .book-card .description {
            margin-top: 12px;
            margin-bottom: 0;
            color: rgba(69, 9, 32, 0.75);
            font-size: 16px;
            line-height: 1.8;
            overflow-wrap: break-word;
        }

        .book-card .explore-link {
            margin-top: auto;
            padding-top: 22px;
            color: #a53860;
            font-size: 16px;
            font-weight: 700;
        }

        .pink-button {
            background-color: #a53860;
            color: white;
            transition: background-color 0.2s ease;
        }

        .pink-button:hover {
            background-color: #450920;
        }

        @media (max-width: 640px) {
            .book-card {
                padding: 22px;
            }

            .book-card h3 {
                font-size: 25px;
            }

            .book-card .description {
                font-size: 15px;
            }
        }
    </style>
</head>

<body>

    <%- include('includes/nav.ejs') %>


    <!-- HERO SECTION -->

    <section class="px-6 py-12 md:py-20">

        <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2">

            <div>

                <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    Welcome to Bloom Reads
                </p>

                <h1 class="heading text-4xl leading-tight sm:text-5xl lg:text-6xl">
                    Turn the page.
                    <br>
                    <span class="text-[#a53860]">Find your bloom.</span>
                </h1>

                <p class="mt-6 max-w-lg leading-7 text-[#450920]/75">
                    Discover books that inspire you, take you on adventures
                    and help you learn something new. Your next favourite
                    book might be waiting here!
                </p>

                <div class="mt-7 flex flex-wrap gap-3">

                    <a href="/books"
                       class="pink-button rounded-lg px-6 py-3 text-sm font-semibold">
                        Browse Books →
                    </a>

                    <a href="/categories"
                       class="rounded-lg border border-[#a53860] px-6 py-3 text-sm font-semibold text-[#a53860] hover:bg-[#ffa5ab]/20">
                        Explore Categories
                    </a>

                </div>

            </div>


            <!-- HERO IMAGE -->

            <div class="mx-auto w-full max-w-md">

                <img
                    src="/uploads/h4.jpg"
                    alt="Books and reading"
                    class="h-[300px] w-full rounded-2xl object-cover shadow-md sm:h-[380px]"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >

                <div class="hidden h-[300px] flex-col items-center justify-center rounded-2xl bg-[#f9dbbd] sm:h-[380px]">

                    <p class="heading text-2xl text-[#450920]">
                        A World of Stories
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- SMALL INTRO SECTION -->

    <section class="bg-[#f9dbbd]/60 px-6 py-10 text-center">

        <h2 class="heading text-2xl sm:text-3xl">
            Every book has a story to tell.
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-[#450920]/75 sm:text-base">
            Find something you love, explore new ideas and make time
            for reading with Bloom Reads.
        </p>

    </section>


    <!-- ABOUT SECTION -->

    <section class="px-6 py-14 md:py-16">

        <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2">

            <div class="w-full">

                <img
                    src="/uploads/book-stack.jpg"
                    alt="A stack of books"
                    class="h-72 w-full rounded-2xl object-cover sm:h-80"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >

                <div class="hidden h-72 flex-col items-center justify-center rounded-2xl bg-[#f9dbbd] sm:h-80">

                    <p class="heading text-xl text-[#450920]">
                        Happy Reading!
                    </p>

                </div>

            </div>


            <div class="md:pl-4">

                <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    About Us
                </p>

                <h2 class="heading text-3xl leading-snug sm:text-4xl">
                    A little corner for every reader.
                </h2>

                <p class="mt-5 leading-7 text-[#450920]/75">
                    Bloom Reads is an online bookstore made for people who
                    enjoy reading and discovering new books.
                </p>

                <p class="mt-4 leading-7 text-[#450920]/75">
                    From exciting fiction to educational books, we bring
                    different genres together so you can easily find
                    something interesting to read.
                </p>

                <a href="/about"
                   class="pink-button mt-6 inline-block rounded-lg px-6 py-3 text-sm font-semibold">
                    Learn More →
                </a>

            </div>

        </div>

    </section>


    <!-- POPULAR CATEGORIES -->

    <section class="bg-[#f9dbbd]/40 px-6 py-16">

        <div class="mx-auto max-w-6xl">

            <div class="mb-10 text-center">

                <p class="text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                    Explore Books
                </p>

                <h2 class="heading mt-3 text-3xl sm:text-4xl">
                    Find Your Favourite Genre
                </h2>

                <p class="mt-3 text-sm text-[#450920]/70 sm:text-base">
                    Choose a category and start exploring.
                </p>

            </div>


            <!-- Equal-height responsive category cards -->

            <div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-3">


                <!-- FICTION -->

                <a href="/categories/Fiction" class="book-card">

                    <div class="category-label bg-[#ffa5ab]/40">
                        <span>FICTION</span>
                    </div>

                    <h3>Fiction</h3>

                    <p class="description">
                        Enjoy imaginative stories and exciting adventures.
                    </p>

                    <p class="explore-link">
                        Explore Books →
                    </p>

                </a>


                <!-- ACADEMICS -->

                <a href="/categories/Academics" class="book-card">

                    <div class="category-label bg-[#f9dbbd]">
                        <span>STUDY</span>
                    </div>

                    <h3>Academics</h3>

                    <p class="description">
                        Find educational books and helpful study material.
                    </p>

                    <p class="explore-link">
                        Explore Books →
                    </p>

                </a>


                <!-- MYSTERY -->

                <a href="/categories/Mystery" class="book-card">

                    <div class="category-label bg-[#a53860]/15">
                        <span>MYSTERY</span>
                    </div>

                    <h3>Mystery</h3>

                    <p class="description">
                        Discover secrets, solve mysteries and enjoy surprises.
                    </p>

                    <p class="explore-link">
                        Explore Books →
                    </p>

                </a>


                <!-- FANTASY -->

                <a href="/categories/Fantasy" class="book-card">

                    <div class="category-label bg-[#ffa5ab]/40">
                        <span>FANTASY</span>
                    </div>

                    <h3>Fantasy</h3>

                    <p class="description">
                        Step into magical worlds and extraordinary adventures.
                    </p>

                    <p class="explore-link">
                        Explore Books →
                    </p>

                </a>


                <!-- SCIENCE -->

                <a href="/categories/Science" class="book-card">

                    <div class="category-label bg-[#f9dbbd]">
                        <span>SCIENCE</span>
                    </div>

                    <h3>Science</h3>

                    <p class="description">
                        Learn about science, discoveries and the world around us.
                    </p>

                    <p class="explore-link">
                        Explore Books →
                    </p>

                </a>


                <!-- POETRY -->

<a href="/categories/Poetry" class="book-card">

    <div class="category-label bg-[#a53860]/15">
        <span>POETRY</span>
    </div>

    <h3>Poetry</h3>

    <p class="description">
        Discover beautiful poems and heartfelt words.
    </p>

    <p class="explore-link">
        Explore Books →
    </p>

</a>


            </div>


            <div class="mt-10 text-center">

                <a href="/categories"
                   class="pink-button inline-block rounded-lg px-7 py-3 font-semibold">
                    View All Categories →
                </a>

            </div>

        </div>

    </section>


    <!-- READING MESSAGE -->

    <section class="px-6 py-16">

        <div class="mx-auto max-w-4xl rounded-2xl bg-[#450920] px-6 py-12 text-center text-white sm:px-12">

            <p class="text-sm font-semibold uppercase tracking-widest text-[#ffa5ab]">
                A Little Reminder
            </p>

            <h2 class="heading mt-4 text-3xl sm:text-4xl">
                Every reader starts with one page.
            </h2>

            <p class="mx-auto mt-4 max-w-xl leading-7 text-white/80">
                Take a break, pick a book and enjoy a few moments
                in a world full of imagination.
            </p>

            <a href="/books"
               class="mt-7 inline-block rounded-lg bg-[#ffa5ab] px-6 py-3 font-semibold text-[#450920] hover:bg-[#f9dbbd]">
                Find Your Next Book →
            </a>

        </div>

    </section>


    <!-- CONTACT SECTION -->

    <section class="px-6 pb-16">

        <div class="mx-auto max-w-4xl rounded-2xl border border-[#a53860]/20 bg-white px-6 py-10 text-center">

            <h2 class="heading text-3xl sm:text-4xl">
                Have a question?
            </h2>

            <p class="mx-auto mt-4 max-w-xl leading-7 text-[#450920]/70">
                Have a suggestion or need help? We would love to hear from you.
            </p>

            <a href="/contact"
               class="pink-button mt-6 inline-block rounded-lg px-6 py-3 font-semibold">
                Contact Us →
            </a>

        </div>

    </section>


    <!-- FOOTER -->

    <%- include('includes/footer.ejs') %>

</body>

</html>