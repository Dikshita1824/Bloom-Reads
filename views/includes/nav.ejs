<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&display=swap" rel="stylesheet">

<nav class="bg-[#641E36] text-[#FFF9F5] px-5 md:px-8 py-4 shadow-md border-b border-[#F5D4D8]/30">

    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">

        <!-- LOGO -->
        <a href="/" class="bloom-logo-link">
            <span class="bloom-logo-text">
                Bloom <span>Reads</span>
            </span>
        </a>

        <style>
            .bloom-logo-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
                text-decoration: none;
            }

            .bloom-logo-text {
                font-family: 'Cormorant Garamond', Georgia, serif !important;
                font-size: 30px;
                font-weight: 600;
                line-height: 1.2;
                letter-spacing: 0.5px;
                color: #FFF9F5;
                white-space: nowrap;
                transition: color 0.3s ease;
            }

            .bloom-logo-text span {
                color: #F5D4D8;
                font-style: italic;
            }

            .bloom-logo-link:hover .bloom-logo-text {
                color: #F5D4D8;
            }
        </style>

        <!-- NAVIGATION -->
        <div class="flex flex-wrap justify-center items-center gap-1">

            <a href="/"
               class="px-3 py-2 rounded-md text-[15px] font-medium tracking-wide hover:bg-[#F5D4D8] hover:text-[#641E36] transition duration-300">
                Home
            </a>

            <a href="/about"
               class="px-3 py-2 rounded-md text-[15px] font-medium tracking-wide hover:bg-[#F5D4D8] hover:text-[#641E36] transition duration-300">
                About
            </a>

            <a href="/books"
               class="px-3 py-2 rounded-md text-[15px] font-medium tracking-wide hover:bg-[#F5D4D8] hover:text-[#641E36] transition duration-300">
                Books
            </a>

            <a href="/categories"
               class="px-3 py-2 rounded-md text-[15px] font-medium tracking-wide hover:bg-[#F5D4D8] hover:text-[#641E36] transition duration-300">
                Categories
            </a>

            <a href="/contact"
               class="px-3 py-2 rounded-md text-[15px] font-medium tracking-wide hover:bg-[#F5D4D8] hover:text-[#641E36] transition duration-300">
                Contact
            </a>

            <!-- CART BUTTON -->
            <a href="/cart"
               class="relative ml-2 px-4 py-2 rounded-full
                      bg-[#FFF9F5] text-[#641E36]
                      text-sm font-semibold
                      border border-[#F5D4D8]
                      hover:bg-[#F5D4D8]
                      transition duration-300">

                Cart

                <span id="cartCount"
                      class="hidden absolute -top-2 -right-2
                             min-w-5 h-5 px-1
                             items-center justify-center
                             rounded-full bg-[#E9A4B2]
                             text-[#641E36] text-xs font-bold
                             border border-white">
                    0
                </span>

            </a>

            <!-- ADMIN -->
            <% if (isAdmin) { %>

                <a href="/books"
                   class="ml-2 px-4 py-2 rounded-full
                          bg-[#F5D4D8] text-[#641E36]
                          text-[13px] font-semibold
                          border border-[#F5D4D8]
                          hover:bg-[#FFF9F5]
                          hover:border-[#FFF9F5]
                          transition duration-300">

                    Admin

                </a>

            <% } else { %>

                <a href="/admin/login"
                   class="ml-2 px-4 py-2 rounded-full
                          bg-[#F5D4D8] text-[#641E36]
                          text-[13px] font-semibold
                          border border-[#F5D4D8]
                          hover:bg-[#FFF9F5]
                          hover:border-[#FFF9F5]
                          transition duration-300">

                    Admin

                </a>

            <% } %>

        </div>

    </div>

</nav>


<!-- CART COUNTER SCRIPT -->
<script>
    function updateCartCounter() {

        let cart = [];

        try {
            cart = JSON.parse(localStorage.getItem("bloomReadsCart")) || [];
        } catch (error) {
            cart = [];
        }

        const totalItems = cart.reduce(function (total, item) {
            return total + Number(item.quantity || 0);
        }, 0);

        const counter = document.getElementById("cartCount");

        if (counter) {
            counter.textContent = totalItems;

            counter.classList.toggle("hidden", totalItems === 0);
            counter.classList.toggle("flex", totalItems > 0);
        }
    }

    updateCartCounter();

    window.addEventListener("storage", updateCartCounter);
</script>