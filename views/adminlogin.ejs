<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login | Bloom Reads</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #fff8f3;
            color: #450920;
            font-family: 'DM Sans', sans-serif;
        }

        .heading {
            font-family: 'Playfair Display', serif;
        }

        .login-wrapper {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 45px 30px;
        }

        .login-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 570px;
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(69, 9, 32, 0.08);
        }

        /* LEFT SIDE */

        .welcome-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 45px;
            background: #f9dbbd;
            overflow: hidden;
        }

        .welcome-panel::before {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            right: -90px;
            top: -90px;
            border-radius: 50%;
            background: rgba(255, 165, 171, 0.45);
        }

        .welcome-panel::after {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            bottom: -90px;
            left: -70px;
            border-radius: 50%;
            background: rgba(165, 56, 96, 0.08);
        }

        .welcome-content,
        .welcome-bottom {
            position: relative;
            z-index: 1;
        }

        .brand-name {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 700;
        }

        .brand-symbol {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #450920;
            color: white;
            font-size: 23px;
        }

        .welcome-heading {
            margin-top: 65px;
            font-size: clamp(36px, 4vw, 53px);
            line-height: 1.15;
            color: #450920;
        }

        .welcome-description {
            max-width: 390px;
            margin-top: 18px;
            color: rgba(69, 9, 32, 0.75);
            font-size: 14px;
            line-height: 1.9;
        }

        .welcome-image {
            width: 100%;
            height: 175px;
            margin-top: 28px;
            border-radius: 12px;
            object-fit: cover;
        }

        .image-fallback {
            display: none;
            height: 175px;
            margin-top: 28px;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 8px;
            border-radius: 12px;
            background: #ffa5ab;
            color: #450920;
        }

        .welcome-bottom {
            margin-top: 28px;
            font-size: 12px;
            color: rgba(69, 9, 32, 0.7);
        }

        /* RIGHT SIDE */

        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 45px;
        }

        .form-content {
            width: 100%;
            max-width: 370px;
        }

        .form-label {
            display: block;
            margin-bottom: 9px;
            font-size: 13px;
            font-weight: 600;
            color: #450920;
        }

        .form-input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #ead5db;
            border-radius: 8px;
            background: #fffaf8;
            color: #450920;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-input:focus {
            border-color: #a53860;
            box-shadow: 0 0 0 3px rgba(165, 56, 96, 0.1);
        }

        .form-input::placeholder {
            color: #b49ba2;
        }

        .login-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #450920;
            color: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        .login-button:hover {
            background: #a53860;
        }

        .return-link {
            display: inline-block;
            margin-top: 24px;
            color: #a53860;
            font-size: 13px;
            text-decoration: none;
        }

        .return-link:hover {
            color: #450920;
            text-decoration: underline;
        }

        .form-note {
            margin-top: 28px;
            padding: 12px;
            border-radius: 8px;
            background: #fff3ef;
            color: #875466;
            font-size: 12px;
            line-height: 1.6;
        }

        @media (max-width: 800px) {
            .login-wrapper {
                padding: 25px 20px;
            }

            .login-layout {
                grid-template-columns: 1fr;
            }

            .welcome-panel {
                padding: 30px;
            }

            .welcome-heading {
                margin-top: 35px;
                font-size: 42px;
            }

            .welcome-image {
                height: 200px;
            }

            .image-fallback {
                height: 200px;
            }

            .welcome-bottom {
                margin-top: 20px;
            }

            .form-panel {
                padding: 40px 30px;
            }
        }

        @media (max-width: 480px) {
            .login-wrapper {
                padding: 18px 12px;
            }

            .welcome-panel {
                padding: 24px;
            }

            .welcome-heading {
                font-size: 36px;
            }

            .form-panel {
                padding: 35px 23px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR: unchanged -->
    <%- include('includes/nav.ejs') %>


    <!-- ADMIN LOGIN -->

    <main class="login-wrapper">

        <div class="login-layout">

            <!-- LEFT WELCOME PANEL -->

            <section class="welcome-panel">

                <div class="welcome-content">

                    <div class="brand-name">
                        <span class="brand-symbol">✿</span>
                        <span>Bloom Reads</span>
                    </div>

                    <p class="mt-8 text-xs font-bold uppercase tracking-widest text-[#a53860]">
                        Admin Dashboard
                    </p>

                    <h1 class="heading welcome-heading">
                        Your library,
                        <br>
                        your story.
                    </h1>

                    <p class="welcome-description">
                        Welcome to the Bloom Reads administration panel.
                        Sign in to manage your books and keep your library
                        organised.
                    </p>

                    <!-- Image with fallback -->

                    <img
                        src="/uploads/reading-corner.png"
                        alt="Books in the Bloom Reads library"
                        class="welcome-image"
                        onerror="this.style.display='none';document.getElementById('loginImageFallback').style.display='flex'"
                    >

                    <div id="loginImageFallback" class="image-fallback">
                        <span class="text-5xl">📚</span>
                        <p class="heading text-xl">A World of Stories</p>
                    </div>

                </div>

                <div class="welcome-bottom">
                    Made for readers, managed with care. ♡
                </div>

            </section>


            <!-- RIGHT LOGIN PANEL -->

            <section class="form-panel">

                <div class="form-content">

                    <p class="text-sm font-semibold uppercase tracking-widest text-[#a53860]">
                        Welcome Back
                    </p>

                    <h2 class="heading mt-3 text-4xl sm:text-5xl">
                        Admin Login
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-[#450920]/65">
                        Enter your login details to access your dashboard.
                    </p>


                    <!-- LOGIN FORM: original functionality preserved -->

                    <form action="/admin/login"
                          method="post"
                          class="mt-8 space-y-5">

                        <!-- USERNAME -->

                        <div>

                            <label for="username" class="form-label">
                                Username
                            </label>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                required
                                autocomplete="username"
                                placeholder="Enter your username"
                                class="form-input"
                            >

                        </div>


                        <!-- PASSWORD -->

                        <div>

                            <label for="password" class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                required
                                autocomplete="current-password"
                                placeholder="Enter your password"
                                class="form-input"
                            >

                        </div>


                        <!-- SUBMIT BUTTON -->

                        <button type="submit" class="login-button">
                            Login to Dashboard →
                        </button>

                    </form>


                    <!-- INFORMATION -->

                    <div class="form-note">
                        <strong>Admin access only.</strong>
                        <br>
                        This area is reserved for authorised administrators.
                    </div>


                    <!-- RETURN LINK: unchanged -->

                    <a href="/books" class="return-link">
                        ← Back to the Bookstore
                    </a>

                </div>

            </section>

        </div>

    </main>


    <!-- FOOTER: unchanged -->
    <%- include('includes/footer.ejs') %>

</body>

</html>