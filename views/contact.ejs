<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact | Bloom Reads</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #FFF9F5;
            color: #492632;
        }

        h1,
        h2 {
            font-family: 'Cormorant Garamond', serif;
        }

        .contact-input {
            width: 100%;
            padding: 13px 16px;
            border: 1px solid #E8C5CD;
            border-radius: 9px;
            background: #FFF9F5;
            color: #492632;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .contact-input::placeholder {
            color: #B58B96;
        }

        .contact-input:focus {
            outline: none;
            border-color: #A04460;
            box-shadow: 0 0 0 3px rgba(160, 68, 96, 0.12);
        }

        .contact-label {
            display: block;
            margin-bottom: 9px;
            color: #641E36;
            font-size: 13px;
            font-weight: 500;
        }

        .contact-submit {
            width: 100%;
            padding: 14px 20px;
            border: 1px solid #641E36;
            border-radius: 9px;
            background: #641E36;
            color: #FFFFFF;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: background 0.3s ease, transform 0.3s ease;
        }

        .contact-submit:hover {
            border-color: #A04460;
            background: #A04460;
            transform: translateY(-2px);
        }

        .contact-card {
            border: 1px solid #F5D4D8;
            border-radius: 18px;
            background: #FBE8DF;
            box-shadow: 0 12px 35px rgba(100, 30, 54, 0.07);
        }

        .contact-heading-line {
            width: 65px;
            height: 3px;
            margin: 16px auto 0;
            border-radius: 5px;
            background: #A04460;
        }

        @media (max-width: 640px) {
            .contact-section {
                padding: 45px 18px;
            }

            .contact-title {
                font-size: 42px;
            }

            .contact-card {
                padding: 24px 20px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->

    <%- include('includes/nav.ejs') %>


    <!-- CONTACT SECTION -->

    <section class="contact-section min-h-screen px-5 py-14">

        <!-- PAGE HEADING -->

        <div class="mb-10 text-center">

            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em]"
               style="color:#A04460;">
                We'd Love to Hear From You
            </p>

            <h1 class="contact-title text-5xl font-bold"
                style="color:#641E36;">
                Get in Touch
            </h1>

            <div class="contact-heading-line"></div>

            <p class="mx-auto mt-5 max-w-lg text-sm leading-7"
               style="color:#A77C87;">
                Have a question? We'd love to hear from you.
                Send us a message and we'll get back to you.
            </p>

        </div>


        <!-- CONTACT FORM CARD -->

        <div class="contact-card mx-auto max-w-xl p-6 md:p-9">

            <!-- FORM HEADING -->

            <div class="mb-7">

                <h2 class="mb-2 text-3xl font-semibold"
                    style="color:#641E36;">
                    Send Us a Message
                </h2>

                <p class="text-sm leading-6"
                   style="color:#A77C87;">
                    Fill in the details below and we'll get back to you.
                </p>

            </div>


            <!-- CONTACT FORM -->

            <form action="/contact" method="POST" class="space-y-5">

                <!-- NAME -->

                <div>

                    <label for="name" class="contact-label">
                        Your Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Enter your name"
                        autocomplete="name"
                        required
                        class="contact-input"
                    >

                </div>


                <!-- EMAIL -->

                <div>

                    <label for="email" class="contact-label">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                        class="contact-input"
                    >

                </div>


                <!-- MOBILE NUMBER -->

                <div>

                    <label for="mobile" class="contact-label">
                        Mobile Number
                    </label>

                    <input
                        type="tel"
                        id="mobile"
                        name="mobile"
                        placeholder="Enter your mobile number"
                        autocomplete="tel"
                        class="contact-input"
                    >

                </div>


                <!-- MESSAGE -->

                <div>

                    <label for="message" class="contact-label">
                        Your Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Write your message here..."
                        required
                        class="contact-input resize-none"
                    ></textarea>

                </div>


                <!-- SUBMIT BUTTON -->

                <div class="pt-2">

                    <button
                        type="submit"
                        class="contact-submit"
                    >
                        Send Message
                    </button>

                </div>

            </form>

        </div>

    </section>


    <!-- FOOTER -->

    <%- include('includes/footer.ejs') %>

</body>

</html>