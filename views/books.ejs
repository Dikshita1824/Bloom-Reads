<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Books - Bloom Reads</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: #FFF9F5;
            color: #492632;
        }

        .book-card {
            background: #FFFFFF;
            border: 1px solid #F0DDE0;
            border-radius: 18px;
            overflow: hidden;
            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(100, 30, 54, 0.10);
            border-color: #D9AAB6;
        }

        .book-cover-area {
            background: linear-gradient(145deg, #FBECE7, #F8E0E2);
            position: relative;
            min-height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .book-cover-area img {
            width: 170px;
            height: 230px;
            object-fit: contain;
            filter: drop-shadow(0 10px 12px rgba(73, 38, 50, 0.16));
            transition: transform 0.4s ease;
        }

        .book-card:hover .book-cover-area img {
            transform: scale(1.05) rotate(-1deg);
        }

        .book-number {
            position: absolute;
            top: 15px;
            left: 15px;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 249, 245, 0.9);
            color: #641E36;
            font-size: 12px;
            font-weight: 600;
        }

        .category-badge {
            display: inline-block;
            background: #FBE8EB;
            color: #8E3C56;
            border-radius: 30px;
            padding: 6px 11px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

        .book-title {
            color: #641E36;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 23px;
            line-height: 1.3;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .book-author {
            color: #A77C87;
            font-size: 13px;
            line-height: 1.7;
        }

        .book-price {
            color: #641E36;
            font-size: 24px;
            font-weight: 700;
        }

        .book-divider {
            height: 1px;
            background: #F2E3E5;
        }

        .add-to-cart-btn,
        .buy-now-btn {
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            padding: 10px 8px;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.25s ease;
            cursor: pointer;
        }

        .add-to-cart-btn {
            border: 1px solid #641E36;
            background: white;
            color: #641E36;
        }

        .add-to-cart-btn:hover {
            background: #FBE8EB;
        }

        .buy-now-btn {
            border: 1px solid #641E36;
            background: #641E36;
            color: white;
        }

        .buy-now-btn:hover {
            background: #A04460;
            border-color: #A04460;
        }

        .admin-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.25s ease;
        }

        .edit-action {
            border: 1px solid #A04460;
            color: #641E36;
        }

        .edit-action:hover {
            background: #FBE8EB;
        }

        .delete-action {
            background: #641E36;
            color: white;
            border: 1px solid #641E36;
            cursor: pointer;
        }

        .delete-action:hover {
            background: #A04460;
        }

        .availability-label {
            color: #9A5369;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        @media (max-width: 639px) {
            .book-cover-area {
                min-height: 250px;
            }

            .book-cover-area img {
                width: 150px;
                height: 205px;
            }

            .book-title {
                font-size: 21px;
            }
        }
    </style>
</head>

<body class="bg-[#FFF9F5] text-[#492632]">

    <%- include('includes/nav.ejs') %>

    <%
        const defaultBooks = [
            {
                title: "The Great Gatsby",
                author: "F. Scott Fitzgerald",
                price: 299,
                category: "Classic",
                image: "https://covers.openlibrary.org/b/title/The%20Great%20Gatsby-L.jpg"
            },
            {
                title: "Pride and Prejudice",
                author: "Jane Austen",
                price: 349,
                category: "Romance",
                image: "https://covers.openlibrary.org/b/title/Pride%20and%20Prejudice-L.jpg"
            },
            {
                title: "Harry Potter and the Philosopher's Stone",
                author: "J. K. Rowling",
                price: 499,
                category: "Fantasy",
                image: "https://covers.openlibrary.org/b/title/Harry%20Potter%20and%20the%20Philosophers%20Stone-L.jpg"
            },
            {
                title: "The Hobbit",
                author: "J. R. R. Tolkien",
                price: 399,
                category: "Fantasy",
                image: "https://covers.openlibrary.org/b/title/The%20Hobbit-L.jpg"
            },
            {
                title: "Murder on the Orient Express",
                author: "Agatha Christie",
                price: 329,
                category: "Mystery",
                image: "https://covers.openlibrary.org/b/title/Murder%20on%20the%20Orient%20Express-L.jpg"
            },
            {
                title: "The Alchemist",
                author: "Paulo Coelho",
                price: 279,
                category: "Fiction",
                image: "https://covers.openlibrary.org/b/title/The%20Alchemist-L.jpg"
            },
            {
                title: "To Kill a Mockingbird",
                author: "Harper Lee",
                price: 359,
                category: "Classic",
                image: "https://covers.openlibrary.org/b/title/To%20Kill%20a%20Mockingbird-L.jpg"
            },
            {
                title: "The Fault in Our Stars",
                author: "John Green",
                price: 299,
                category: "Romance",
                image: "https://covers.openlibrary.org/b/title/The%20Fault%20in%20Our%20Stars-L.jpg"
            },
            {
                title: "The Complete Sherlock Holmes",
                author: "Arthur Conan Doyle",
                price: 449,
                category: "Mystery",
                image: "https://covers.openlibrary.org/b/title/The%20Complete%20Sherlock%20Holmes-L.jpg"
            },
            {
                title: "Atomic Habits",
                author: "James Clear",
                price: 499,
                category: "Self-Help",
                image: "https://covers.openlibrary.org/b/title/Atomic%20Habits-L.jpg"
            },
            {
                title: "The Power of Your Subconscious Mind",
                author: "Joseph Murphy",
                price: 249,
                category: "Self-Help",
                image: "https://covers.openlibrary.org/b/title/The%20Power%20of%20Your%20Subconscious%20Mind-L.jpg"
            },
            {
                title: "The Little Prince",
                author: "Antoine de Saint-Exupéry",
                price: 229,
                category: "Fiction",
                image: "https://covers.openlibrary.org/b/title/The%20Little%20Prince-L.jpg"
            }
        ];

        const displayBooks = (typeof books !== 'undefined' && books.length > 0)
            ? books
            : defaultBooks;
    %>

    <!-- ADMIN CONTROLS -->

    <% if (isAdmin) { %>

        <div class="max-w-7xl mx-auto px-6 flex flex-wrap justify-end gap-3 mt-6">

            <a href="/books/new"
               class="bg-[#641E36] text-[#FFF9F5] px-5 py-3 rounded-lg uppercase tracking-wider text-sm hover:bg-[#A04460] transition duration-300">
                Add Book
            </a>

            <a href="/admin/logout"
               class="border border-[#641E36] text-[#641E36] px-5 py-3 rounded-lg uppercase tracking-wider text-sm hover:bg-[#641E36] hover:text-white transition duration-300">
                Logout
            </a>

        </div>

    <% } %>

    <!-- BOOK COLLECTION -->

    <section class="px-5 md:px-8 py-10 md:py-12">

        <div class="max-w-7xl mx-auto">

            <!-- HEADING -->

            <div class="mb-6">

                <p class="text-center text-[#A04460] uppercase tracking-[0.3em] text-xs md:text-sm mb-4">
                    Discover Your Next Favourite
                </p>

                <h1 class="text-center font-serif text-5xl md:text-6xl text-[#641E36]">
                    Our Books
                </h1>

                <p class="text-center text-[#A77C87] mt-5 max-w-2xl mx-auto leading-7 text-sm md:text-base">
                    Every book opens a new world.
                    Find your next beautiful read at Bloom Reads.
                </p>

            </div>

            <!-- DECORATIVE LINE WITHOUT ICONS -->

            <div class="flex items-center justify-center mb-10">
                <span class="h-px w-24 bg-[#F0CDD4]"></span>
            </div>

            <!-- SUCCESS MESSAGE -->

            <div id="cartMessage"
                 role="status"
                 aria-live="polite"
                 class="hidden max-w-2xl mx-auto mb-8 bg-[#FBE8EB] text-[#641E36] border border-[#E8C4CD] rounded-xl px-5 py-4 text-center text-sm">
            </div>

            <!-- BOOK GRID -->

            <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">

                <% displayBooks.forEach((book, index) => { %>

                    <%
                        const bookId = book._id
                            ? book._id.toString()
                            : 'default-' + encodeURIComponent(book.title);
                    %>

                    <article class="book-card flex flex-col">

                        <!-- BOOK COVER -->

                        <div class="book-cover-area">

                            <span class="book-number">
                                <%= String(index + 1).padStart(2, '0') %>
                            </span>

                            <img
                                src="<%= book.image %>"
                                alt="<%= book.title %>"
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://placehold.co/400x550/FBE8DF/641E36?text=Bloom+Reads';">

                        </div>

                        <!-- BOOK DETAILS -->

                        <div class="p-5 md:p-6 flex flex-col flex-1">

                            <div class="mb-4">
                                <span class="category-badge">
                                    <%= book.category || 'Books' %>
                                </span>
                            </div>

                            <h2 class="book-title mb-3">
                                <%= book.title %>
                            </h2>

                            <p class="book-author mb-5">
                                <span class="text-[#492632] font-semibold">
                                    Written by
                                </span>

                                <br>

                                <%= book.author %>
                            </p>

                            <!-- PRICE SECTION -->

                            <div class="book-divider mb-4"></div>

                            <div class="flex items-center justify-between gap-3 mb-5">

                                <div>
                                    <p class="text-[#A77C87] text-xs mb-1">
                                        Price
                                    </p>

                                    <p class="book-price">
                                        ₹<%= book.price %>
                                    </p>
                                </div>

                                <div class="text-right">
                                    <p class="availability-label">
                                        Available
                                    </p>

                                    <p class="text-[#B58B96] text-xs mt-1">
                                        In our collection
                                    </p>
                                </div>

                            </div>

                            <!-- CUSTOMER PURCHASE BUTTONS -->

                            <% if (!isAdmin) { %>

                                <div class="grid grid-cols-2 gap-3 mt-auto">

                                    <button
                                        type="button"
                                        class="add-to-cart-btn"
                                        data-id="<%= bookId %>"
                                        data-title="<%= book.title %>"
                                        data-author="<%= book.author %>"
                                        data-price="<%= book.price %>"
                                        data-image="<%= book.image %>">

                                        Add to Cart

                                    </button>

                                    <button
                                        type="button"
                                        class="buy-now-btn"
                                        data-id="<%= bookId %>"
                                        data-title="<%= book.title %>"
                                        data-author="<%= book.author %>"
                                        data-price="<%= book.price %>"
                                        data-image="<%= book.image %>">

                                        Buy Now

                                    </button>

                                </div>

                            <% } %>

                            <!-- ADMIN EDIT / DELETE -->

                            <% if (isAdmin && book._id) { %>

                                <div class="flex flex-wrap gap-3 mt-5 pt-4 border-t border-[#F2E3E5]">

                                    <a
                                        href="/books/edit/<%= book._id %>"
                                        class="admin-action edit-action">

                                        Edit

                                    </a>

                                    <form
                                        action="/books/delete/<%= book._id %>"
                                        method="POST">

                                        <button
                                            type="submit"
                                            onclick="return confirm('Are you sure you want to delete this book?')"
                                            class="admin-action delete-action">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </main>

        </div>

    </section>

    <!-- FOOTER -->

    <%- include('includes/footer.ejs') %>

    <!-- CART JAVASCRIPT -->

    <script>

        function getCart() {
            try {
                return JSON.parse(localStorage.getItem("bloomReadsCart")) || [];
            } catch (error) {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem("bloomReadsCart", JSON.stringify(cart));
            updateCartCounter();
        }

        function updateCartCounter() {

            const cart = getCart();

            const totalItems = cart.reduce(function (total, item) {
                return total + Number(item.quantity || 0);
            }, 0);

            const counter = document.getElementById("cartCount");

            if (counter) {
                counter.textContent = totalItems;
                counter.classList.toggle("hidden", totalItems === 0);
            }
        }

        function addBookToCart(button) {

            const id = button.dataset.id;
            const price = Number(button.dataset.price);

            if (!id || !Number.isFinite(price) || price < 0) {
                alert("Sorry, this book could not be added.");
                return null;
            }

            const book = {
                id: id,
                title: button.dataset.title,
                author: button.dataset.author,
                price: price,
                image: button.dataset.image,
                quantity: 1
            };

            const cart = getCart();

            const existingBook = cart.find(function (item) {
                return item.id === id;
            });

            if (existingBook) {
                existingBook.quantity = Number(existingBook.quantity || 0) + 1;
            } else {
                cart.push(book);
            }

            saveCart(cart);

            return book;
        }

        function showCartMessage(message) {

            const messageBox = document.getElementById("cartMessage");

            if (!messageBox) return;

            messageBox.textContent = message;
            messageBox.classList.remove("hidden");

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

            setTimeout(function () {
                messageBox.classList.add("hidden");
            }, 3000);
        }

        // Add to Cart

        document.querySelectorAll(".add-to-cart-btn").forEach(function (button) {

            button.addEventListener("click", function () {

                const book = addBookToCart(button);

                if (book) {
                    showCartMessage(book.title + " added to your cart!");
                }

            });

        });

        // Buy Now

        document.querySelectorAll(".buy-now-btn").forEach(function (button) {

            button.addEventListener("click", function () {

                const book = addBookToCart(button);

                if (book) {
                    window.location.href = "/cart";
                }

            });

        });

        updateCartCounter();

    </script>

</body>
</html>